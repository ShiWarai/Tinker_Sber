<mujoco model="h1">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.0025" integrator="RK4"/>
  
  <default>
    <joint armature="0.01" damping="0.1" limited="true"/>
    <geom conaffinity="0" condim="3" friction="1 0.005 0.0001" margin="0.001" rgba="0.8 0.6 0.4 1"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>
  
  <asset>
    <texture builtin="flat" name="texplane" height="256" width="256" rgb1="0.8 0.9 0.8" rgb2="0.8 0.9 0.8" type="2d"/>
    <texture builtin="flat" name="texgeom" height="256" width="256" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" type="2d"/>
    <material name="MatPlane" reflectance="0.5" shininess="1" specular="1" texrepeat="20 20" texture="texplane"/>
    <material name="geom" texture="texgeom" texuniform="true"/>
    
    <!-- Mesh assets for H1 -->
    <mesh name="base_link" file="../resources/h1/meshes/base_link.STL" scale="0.001 0.001 0.001"/>
    <mesh name="L0_Link" file="../resources/h1/meshes/L0_Link.STL" scale="0.001 0.001 0.001"/>
    <mesh name="L1_Link" file="../resources/h1/meshes/L1_Link.STL" scale="0.001 0.001 0.001"/>
    <mesh name="L2_Link" file="../resources/h1/meshes/L2_Link.STL" scale="0.001 0.001 0.001"/>
    <mesh name="L3_Link" file="../resources/h1/meshes/L3_Link.STL" scale="0.001 0.001 0.001"/>
    <mesh name="L4_Link_ankle" file="../resources/h1/meshes/L4_Link_ankle.STL" scale="0.001 0.001 0.001"/>
    <mesh name="R0_Link" file="../resources/h1/meshes/R0_Link.STL" scale="0.001 0.001 0.001"/>
    <mesh name="R1_Link" file="../resources/h1/meshes/R1_Link.STL" scale="0.001 0.001 0.001"/>
    <mesh name="R2_Link" file="../resources/h1/meshes/R2_Link.STL" scale="0.001 0.001 0.001"/>
    <mesh name="R3_Link" file="../resources/h1/meshes/R3_Link.STL" scale="0.001 0.001 0.001"/>
    <mesh name="R4_Link_ankle" file="../resources/h1/meshes/R4_Link_ankle.STL" scale="0.001 0.001 0.001"/>
  </asset>
  
  <worldbody>
    <light cutoff="100" diffuse="1 1 1" dir="-0 0 -1.3" directional="true" exponent="1" pos="0 0 1.3" specular=".1 .1 .1"/>
    <geom conaffinity="1" condim="3" name="floor" pos="0 0 0" rgba="0.8 0.9 0.8 1" size="40 40 40" type="plane" material="MatPlane"/>
    
    <!-- H1 Robot Body from include file -->
    <body name="h1" pos="0 0 0.75" quat="1 0 0 0">
        <joint name="float_base" type="free"/>
        <inertial pos="0.00 0 0.036" quat="1 0 0 0" mass="3" diaginertia="0.02538 0.03617 0.01306"/>  
        <geom type="mesh" contype="0" conaffinity="0" group="1" rgba="1 1 1 1" mesh="base_link" />
        <geom type="mesh" rgba="1 1 1 1" mesh="base_link" />
        <site name='imu' size='0.01' pos='0.0 0 0.0'/>

        <body name="L0_Link" pos="-0.002787 0.053542 0.054381">
            <inertial pos="0.0006 0 -0.0529" mass="0.587331" diaginertia="0.0007 0.0004 0.0004" />
            <joint name="J_L0" pos="0 0 0" axis="0 0 1" limited="true" range="-0.7 0.7" />
            <geom type="mesh" contype="0" conaffinity="0" group="1" rgba="0.898039 0.917647 0.929412 1" mesh="L0_Link" />
            <geom type="mesh" rgba="0.898039 0.917647 0.929412 1" mesh="L0_Link" /> 
            <body name="L1_Link" pos="0.016958 0 -0.053917">
