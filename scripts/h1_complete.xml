                    <joint name="J_R2" pos="0 0 0" axis="0 -1 0" limited="true" range="-1.57 1.57" />
                    <geom type="mesh" contype="0" conaffinity="0" group="1" rgba="0.792157 0.819608 0.933333 1" mesh="R2_Link" />
                    <geom type="mesh" rgba="0.792157 0.819608 0.933333 1" mesh="R2_Link" />
                    <body name="R3_Link" pos="0 0 -0.14738">
                        <inertial pos="0 -0.0073 -0.1176" quat="0.707107 0 0 0.707107" mass="0.511662" diaginertia="0.0012 0.0011 0.0002" />
                        <joint name="J_R3" pos="0 0 0" axis="0 -1 0" limited="true" range="0 2.35" />
                        <geom type="mesh" contype="0" conaffinity="0" group="1" rgba="1 1 1 1" mesh="R3_Link" />
                        <geom type="mesh" rgba="1 1 1 1" mesh="R3_Link" />
                        <body name="R4_Link_ankle" pos="0 -0.025 -0.14049">
                            <inertial pos="0.0118 0.0067 -0.0296" quat="0.5 0.5 0.5 0.5" mass="0.17174" diaginertia="0.0003 0.0003 0.0001" />
                            <joint name="J_R4_ankle" pos="0 0 0" axis="0 1 0" limited="true" range="-1.2 1.2" />
                            <geom type="mesh" contype="0" conaffinity="0" group="1" rgba="1 0.90588 0.91765 1" mesh="R4_Link_ankle" />
                            <geom type="mesh" rgba="1 0.90588 0.91765 1" mesh="R4_Link_ankle" />
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </body>
  </worldbody>
  
  <actuator>
    <!-- Left Leg Actuators -->
    <motor joint="J_L0" gear="100"/>
    <motor joint="J_L1" gear="150"/>
    <motor joint="J_L2" gear="200"/>
    <motor joint="J_L3" gear="150"/>
    <motor joint="J_L4_ankle" gear="100"/>
    
    <!-- Right Leg Actuators -->
    <motor joint="J_R0" gear="100"/>
    <motor joint="J_R1" gear="150"/>
    <motor joint="J_R2" gear="200"/>
    <motor joint="J_R3" gear="150"/>
    <motor joint="J_R4_ankle" gear="100"/>
  </actuator>
  
  <sensor>
    <!-- Joint Position Sensors -->
    <jointpos name="L0_pos" joint="J_L0"/>
    <jointpos name="L1_pos" joint="J_L1"/>
    <jointpos name="L2_pos" joint="J_L2"/>
    <jointpos name="L3_pos" joint="J_L3"/>
    <jointpos name="L4_pos" joint="J_L4_ankle"/>
    
    <jointpos name="R0_pos" joint="J_R0"/>
    <jointpos name="R1_pos" joint="J_R1"/>
    <jointpos name="R2_pos" joint="J_R2"/>
    <jointpos name="R3_pos" joint="J_R3"/>
    <jointpos name="R4_pos" joint="J_R4_ankle"/>
    
    <!-- Joint Velocity Sensors -->
    <jointvel name="L0_vel" joint="J_L0"/>
    <jointvel name="L1_vel" joint="J_L1"/>
    <jointvel name="L2_vel" joint="J_L2"/>
    <jointvel name="L3_vel" joint="J_L3"/>
    <jointvel name="L4_vel" joint="J_L4_ankle"/>
    
    <jointvel name="R0_vel" joint="J_R0"/>
    <jointvel name="R1_vel" joint="J_R1"/>
    <jointvel name="R2_vel" joint="J_R2"/>
    <jointvel name="R3_vel" joint="J_R3"/>
    <jointvel name="R4_vel" joint="J_R4_ankle"/>
    
    <!-- IMU Sensor -->
    <framepos objtype="site" objname="imu"/>
    <framequat objtype="site" objname="imu"/>
    <framelinvel objtype="site" objname="imu"/>
    <frameangvel objtype="site" objname="imu"/>
  </sensor>
</mujoco>